{
  "schemaVersion": 1,
  "friendlyName": "Global header",
  "name": "header",
  "description": "Site-wide navigation header with configurable layout and localized labels.",
  "categories": ["global", "navigation"],
  "tags": ["header", "menu", "navigation"],
  "config": {
    "variant": {
      "friendlyName": "Layout",
      "description": "Choose the visual header layout.",
      "type": "select",
      "default": "standard",
      "group": "Layout properties",
      "options": [
        { "label": "Standard", "value": "standard" },
        { "label": "Centered", "value": "centered" },
        { "label": "lefty test", "value": "lefty test" }
      ]
    },
    "sticky": {
      "friendlyName": "Sticky header",
      "description": "Keep the header visible while scrolling.",
      "type": "boolean",
      "default": false,
      "group": "Layout properties"
    },
    "backgroundColor": {
      "friendlyName": "Background color",
      "description": "Header background color.",
      "type": "color",
      "default": "#ffffff",
      "group": "Design"
    },
    "foregroundColor": {
      "friendlyName": "Text color",
      "description": "Header text and link color.",
      "type": "color",
      "default": "#171717",
      "group": "Design"
    },
    "className": { "friendlyName": "CSS classes", "description": "Optional Tailwind or site utility classes.", "type": "string", "default": "", "group": "Advanced" }
  },
  "resources": {
    "siteName": { "value": "Dynamics Commerce", "comment": "Header logo text.", "group": "Brand" }
  },
  "slots": {
    "navigation": { "friendlyName": "Navigation", "description": "Primary header navigation.", "allowedModules": ["navigation"] }
  }
}
