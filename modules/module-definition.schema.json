{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dynamics module definition",
  "type": "object",
  "required": ["schemaVersion", "friendlyName", "name", "description", "categories", "tags", "config", "resources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "friendlyName": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "description": { "type": "string", "minLength": 1 },
    "categories": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "config": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["friendlyName", "type"],
        "properties": {
          "friendlyName": { "type": "string" },
          "description": { "type": "string" },
          "type": { "enum": ["string", "text", "number", "boolean", "color", "select", "url", "image"] },
          "default": {},
          "group": { "type": "string" },
          "required": { "type": "boolean" },
          "options": { "type": "array", "items": { "type": "object", "required": ["label", "value"], "properties": { "label": { "type": "string" }, "value": { "type": "string" } } } }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": { "type": "object", "required": ["value"], "properties": { "value": {}, "comment": { "type": "string" }, "group": { "type": "string" } } }
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["friendlyName", "allowedModules"],
        "properties": {
          "friendlyName": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "allowedModules": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "required": { "type": "boolean" }
        }
      }
    },
    "dataActions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["endpoint", "method", "execution"],
        "properties": {
          "endpoint": { "type": "string", "pattern": "^/api/" },
          "method": { "const": "GET" },
          "execution": { "enum": ["server", "client"] }
        }
      }
    }
  }
}
